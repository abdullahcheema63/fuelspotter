# Copy to .env (cp .env.example .env) and adjust. .env is git-ignored.
# Every value has a working default, so .env is optional for local development.
# Variables already set in the environment (e.g. by Docker) take precedence over .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave unset for the SQLite file in the project folder. Postgres example:
# DATABASE_URL=postgres://spotter:spotter@localhost:5432/spotter

# Cache for geocoding and routing answers. Leave unset for in-process memory. Redis example:
# CACHE_URL=redis://localhost:6379/0

# Planning policy.
# RESERVE_MILES: never plan the tank below this (0-150). 0 = the assignment's full 500-mile range.
# STOP_COST_USD: what one fuel stop is worth. A request may override it.
# START_FUEL_MILES: fuel in the tank at the start. A request may override it.
RESERVE_MILES=0
STOP_COST_USD=10
START_FUEL_MILES=500

# How long the map link returned with a planned trip keeps working (hours). 0 = never expires.
MAP_LINK_HOURS=24

# External services. Nominatim rejects generic user agents, so identify the application.
OSRM_URL=https://router.project-osrm.org/route/v1/driving
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=spotter-fuel-route-assessment/0.1 (your-contact@example.com)
